# ============================================================
# Variáveis de ambiente — copie para .env.local (dev) e
# cadastre no Vercel (Settings → Environment Variables)
# ============================================================

# --- OBRIGATÓRIAS PARA O BUILD (sem elas o deploy falha) ---

# Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Supabase Dashboard → Settings → API → anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Número do WhatsApp de suporte: só dígitos, com DDI e DDD
NEXT_PUBLIC_WHATSAPP_SUPORTE=5511999999999

# --- NECESSÁRIAS EM TEMPO DE EXECUÇÃO (funcionalidades específicas) ---

# Supabase Dashboard → Settings → API → service_role key (SECRETA!)
# Usada por: motor Inngest, webhook de pagamento
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Token combinado no painel do Asaas para autenticar o webhook.
# MÍNIMO 32 CARACTERES — exigência do proprio Asaas no campo authToken.
# Gerar com: openssl rand -hex 32
# Usada por: /api/webhook/pagamento (comparado em tempo constante)
ASAAS_WEBHOOK_TOKEN=

# Chave de criptografia do certificado A1 (32 bytes em base64)
# Gerar com: openssl rand -base64 32
# Usada por: upload do certificado nas configurações
CERT_ENCRYPTION_KEY=

# Chave da API do Asaas (Configurações → Integrações). Sem ela, a tela de
# cobrança avisa que a integração não está configurada e o job de excedentes
# se pula com log — nada quebra, mas nenhuma cobrança é criada.
# Assim que existir, cadastrar/conferir o webhook é uma chamada só:
#   garantirWebhookPagamento(asaasEnv()!, {
#     url: "https://SEU-DOMINIO/api/webhook/pagamento",
#     authToken: process.env.ASAAS_WEBHOOK_TOKEN!,
#     email: "voce@dominio.com.br",
#   })
# e diagnosticarWebhookPagamento(...) devolve o checklist do que está errado.
ASAAS_API_KEY=
# Produção: https://api.asaas.com/v3 (padrão é o sandbox)
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# E-mail transacional (resend.com). Sem a chave, o envio é pulado com log.
RESEND_API_KEY=
# Remetente — o domínio precisa estar verificado no Resend
EMAIL_REMETENTE="Agência Fiscal <notas@seudominio.com.br>"

# Opcional: taxa de falha simulada do provider mock (0 a 1)
MOCK_FISCAL_TAXA_FALHA=0.3

# --- FOCUS NFe (provider fiscal real) ---
# Exigido apenas por empresas com provider_fiscal = 'focusnfe'.
# Painel: https://app-v2.focusnfe.com.br → Painel API → Tokens
# ATENÇÃO: use o token de HOMOLOGAÇÃO enquanto estiver testando.
FOCUSNFE_TOKEN=
# homologacao (padrão) | producao — produção exige troca explícita
FOCUSNFE_AMBIENTE=homologacao
# Opcional: se definido, /api/webhook/focusnfe exige este valor no header
# x-focusnfe-token (mín. 16 chars). A rota reconsulta a API da Focus de
# qualquer forma antes de gravar, então isso é defesa adicional, não a única.
FOCUSNFE_WEBHOOK_TOKEN=

# --- INNGEST (motor de retry) ---
# OBRIGATÓRIAS EM PRODUÇÃO. Sem elas, /api/inngest — que é quem EXECUTA as
# funções, incluindo a máquina de estados da emissão — ou recusa toda execução,
# ou, se o SDK inferir modo de desenvolvimento, PULA a verificação de assinatura
# e aceita POST de qualquer origem. Em dev local (Inngest Dev Server) não são
# usadas. Chaves em: https://app.inngest.com/secrets
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
EMAIL_ALERTAS=
