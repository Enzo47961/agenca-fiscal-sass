+    await atualizarProviderFiscal(db, {
+      empresaId: sessao.empresaId,
+      provider,
+      disponiveis: nomesDeProvidersDisponiveis(),
+    });
+    revalidatePath("/dashboard/configuracoes");
+    return { ok: true };
+  } catch (e) {
+    return { ok: false, erro: e instanceof Error ? e.message : "Erro ao salvar." };
+  }
+}
